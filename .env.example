# Anthropic API Key (for Claude AI features)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base44 Configuration
# These come from your Base44 app settings
VITE_BASE44_APP_ID=your_app_id_here
VITE_BASE44_FUNCTIONS_VERSION=v1
VITE_BASE44_APP_BASE_URL=https://your-app.base44.com

# Optional: API Endpoints
# VITE_API_URL=https://api.example.com
# VITE_CDN_URL=https://cdn.example.com

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_CHAT_WIDGET=true
VITE_ENABLE_CONTENT_GENERATOR=true

# Rate Limiting (requests per hour)
AI_RATE_LIMIT=100

# Logging
VITE_LOG_LEVEL=info
# VITE_LOG_LEVEL=debug  # Uncomment for development

# Environment
VITE_ENV=development
# VITE_ENV=production

# Notes:
# 1. Never commit .env file with real keys
# 2. Copy this file to .env and fill in your actual values
# 3. For production, use secure secret management (AWS Secrets Manager, etc.)
# 4. Different .env files for different environments (.env.production, .env.staging, etc.)
