# Backend Production Environment Variables
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production - add to .gitignore

# ============================================
# CRITICAL: Change these before deploying!
# ============================================

# Database
# ⚠️ DO NOT change - configured in Neon
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXX.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT Secret - CHANGE THIS TO A SECURE RANDOM STRING
# Minimum 32 characters, use: openssl rand -base64 32
JWT_SECRET=your-production-secret-key-min-32-chars-change-this-now-12345678

# Server
NODE_ENV=production
PORT=3001

# CORS - Update with your frontend domain
CORS_ORIGIN=https://teethmocure.com

# Logging
LOG_LEVEL=info

# Error Tracking (Sentry)
# Get this from Sentry dashboard
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# Optional: Database Connection Pool
# These are set by Render/deployment platform
DATABASE_POOL_SIZE=20
DATABASE_POOL_IDLE_TIMEOUT=900

# Optional: Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
